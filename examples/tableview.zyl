database main {
    engine: mariadb
}

table customers {
    id: Id primary auto
    name: String(100) required
    email: Email?
}

table orders {
    id: Id primary auto
    customer: Customer required
    total: Decimal required
}

struct CustomerOverview {
    id: Id
    name: String
    orders: Int
    turnover: Decimal?
}

tableview Customers {
    source sql<CustomerOverview[]> {
        SELECT
            c.id,
            c.name,
            COUNT(o.id) AS orders,
            SUM(o.total) AS turnover
        FROM customers c
        LEFT JOIN orders o ON o.customer_id = c.id
        GROUP BY c.id, c.name
    }

    columns {
        id
        name
        orders
        turnover
    }

    filter {
        name
        orders
        turnover
    }

    searchable
    sortable
    paginated 25
}
