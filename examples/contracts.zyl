fn increment(value: Int) -> Int
    requires {
        value >= 0
    }
    ensures {
        result > value
    }
{
    return value + 1
}

fn increment_local(value: Int) -> Int
    ensures {
        result > value
    }
{
    next = value + 1
    return next
}

fn increment_mutable(value: Int) -> Int
    ensures {
        result > value
    }
{
    mutable next = value
    next = next + 1
    return next
}

fn add_three(value: Int) -> Int
    ensures {
        result >= value + 3
    }
{
    mutable total = value
    mutable count = 0

    while count < 3 {
        total = total + 1
        count = count + 1
    }

    return total
}

fn twice(value: Int) -> Int
    requires {
        value >= 0
    }
    ensures {
        result > value
    }
{
    return increment(increment(value))
}

fn known_call() -> Int
    ensures {
        result == 43
    }
{
    return increment(42)
}

fn non_negative(value: Int) -> Int
    requires {
        value >= 0
    }
{
    return value
}

fn safe_call(value: Int) -> Int
    requires {
        value >= 0
    }
    ensures {
        result >= 0
    }
{
    return non_negative(value)
}

fn unchecked_call(value: Int) -> Int
    ensures {
        result >= 0
    }
{
    return non_negative(value)
}

fn absolute(value: Int) -> Int
    ensures {
        result >= 0
    }
{
    if value >= 0 {
        return value
    } else {
        return -value
    }
}

fn classify(value: Int) -> Int
    ensures {
        result >= 0
    }
{
    match value {
        0 => {
            return 0
        }
        _ => {
            return 1
        }
    }
}

fn option_flag(value: Int?) -> Int
    ensures {
        result >= 0
    }
{
    match value {
        Some(number) => {
            return 1
        }
        None => {
            return 0
        }
    }
}

fn known_option() -> Int
    ensures {
        result == 4
    }
{
    match Some(4) {
        Some(number) => {
            return number
        }
        None => {
            return 0
        }
    }
}

fn known_result() -> Int
    ensures {
        result == 7
    }
{
    match Ok(7) {
        Ok(number) => {
            return number
        }
        Err(message) => {
            return 0
        }
    }
}

fn main() {
    print(increment(41))
    print(twice(41))
    print(known_call())
    print(absolute(-7))
    print(classify(0))
    print(option_flag(Some(4)))
    print(known_option())
    print(known_result())
}
