fn increment(value: Int) -> Int
    requires {
        value >= 0
    }
    ensures {
        result > value
    }
{
    return value + 1
}

fn absolute(value: Int) -> Int
    ensures {
        result >= 0
    }
{
    if value >= 0 {
        return value
    } else {
        return -value
    }
}

fn classify(value: Int) -> Int
    ensures {
        result >= 0
    }
{
    match value {
        0 => {
            return 0
        }
        _ => {
            return 1
        }
    }
}

fn option_flag(value: Int?) -> Int
    ensures {
        result >= 0
    }
{
    match value {
        Some(number) => {
            return 1
        }
        None => {
            return 0
        }
    }
}

fn main() {
    print(increment(41))
    print(absolute(-7))
    print(classify(0))
    print(option_flag(Some(4)))
}
