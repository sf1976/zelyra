type CustomerId = Id

auth users {
    table: users
    sessions: auth_sessions
    permissions: user_permissions
    roles: user_roles
    role_permissions: role_permissions
    audit: auth_audit_log
    admin_path: "/admin/access"
    admin_permission: "auth.manage"
    admin_role: admin
}

table users {
    id: Id primary auto
    email: Email required unique
    password_hash: String(255) required
    active: Bool default true
}

table auth_sessions {
    id: Id primary auto
    user: User required
    token_hash: String(64) required unique
    expires_at: Timestamp required
}

table user_permissions {
    id: Id primary auto
    user: User required
    permission: String(100) required
}

table user_roles {
    id: Id primary auto
    user: User required
    role: String(100) required
}

table role_permissions {
    id: Id primary auto
    role: String(100) required
    permission: String(100) required
}

table auth_audit_log {
    id: Id primary auto
    actor_user_id: Int?
    event: String(100) required
    target_user_id: Int?
    details: String(1000) required
    created_at: Timestamp default now
}

table customers {
    id: CustomerId primary auto
    name: String(100) required
}

crud Customer -> customers {
    requires auth
    permits "customers.view"
    permits create "customers.create"
    permits edit "customers.edit"
    permits delete "customers.delete"

    list {
        id
        name
    }
}

form CustomerQuickCreate -> customers {
    fields {
        name
    }

    action save {
        requires auth
        permits "customers.create"

        sql {
            INSERT INTO customers (name)
            VALUES (:name)
        }

        redirect "/customers"
    }
}

fn get_customer(id: CustomerId) -> Customer uses Database {
    return sql<Customer> {
        SELECT id, name
        FROM customers
        WHERE id = :id
    }
}

api GET "/api/customers/{id}" {
    handler get_customer
    requires auth
    permits "customers.view"

    input {
        id: CustomerId
    }

    output Customer
    errors {
        404 NotFound
    }
}

fn main() {
}
