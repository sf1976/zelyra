database main {
    engine: mariadb
}

table customers {
    id: Id primary auto
    name: String(100) required
    active: Bool default true
}

crud Customer -> customers {
    title: "Customers"

    list {
        id
        name
        active
    }

    view {
        list {
            mode: cards
            empty: "No customers found."
        }

        detail {
            mode: cards
            title: "Customer details"
        }

        form {
            mode: cards
            title: "Customer form"
            submit: "Save customer"
        }

        delete {
            title: "Delete customer"
            message: "This cannot be undone."
            submit: "Delete now"
        }
    }
}
