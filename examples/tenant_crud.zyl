auth users {
    table: users
    sessions: auth_sessions
    permissions: user_permissions
    memberships: tenant_user
    tenant_owner: tenants.user_id
    audit: auth_audit_log
}

table users {
    id: Id primary auto
    email: Email required unique
    password_hash: String(255) required
    active: Bool default true
}

table auth_sessions {
    id: Id primary auto
    user: User required
    token_hash: String(64) required unique
    expires_at: Timestamp required
    device_label: String(255)
}

table user_permissions {
    id: Id primary auto
    user_id: Int required
    permission: String(100) required
}

table tenants {
    id: Id primary auto
    user: User?
    name: String(255) required
}

table tenant_user {
    id: Id primary auto
    tenant_id: Int required
    user_id: Int required
    role: String(50) required default "employee"
}

table auth_audit_log {
    id: Id primary auto
    actor_user_id: Int?
    event: String(100) required
    target_user_id: Int?
    details: String(1000) required
    created_at: Timestamp default now
}

table invoices {
    id: Id primary auto
    tenant_id: Int required
    title: String(100) required
    deleted_at: Timestamp?
}

table tenant_documents {
    id: Id primary auto
    tenant_id: Int required
    title: String(100) required
    attachment: FileRef? attachment {
        max_size: "1MB"
        allowed_types: ["application/pdf"]
    }
}

table tenant_invoice_action_log {
    id: Id primary auto
    invoice_id: Int required
    tenant_id: Int required
    actor_user_id: Int required
}

crud Invoice -> invoices {
    requires auth
    permits "invoices.view"
    tenant: tenant_id

    action record_actor {
        label: "Record action actor"
        requires auth
        permits "invoices.action"
        uses Database(write)
        execute {
            invoice_id = row.id
            tenant_id = session.tenant_id
            actor_user_id = session.user_id
            sql {
                INSERT INTO tenant_invoice_action_log (invoice_id, tenant_id, actor_user_id)
                VALUES (:invoice_id, :tenant_id, :actor_user_id)
            }
        }
    }

    soft_delete {
        column: deleted_at
    }

    list {
        id
        title
    }
}

crud TenantDocument -> tenant_documents {
    requires auth
    permits "documents.view"
    tenant: tenant_id

    list {
        id
        title
        attachment
    }
}

fn main() {
}
