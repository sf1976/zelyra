type CustomerId = Id

table customers {
    id: CustomerId primary auto
    name: String(100) required
    email: Email
}

fn get_customer(id: CustomerId) -> Customer uses Database {
    return sql<Customer> {
        SELECT id, name, email
        FROM customers
        WHERE id = :id
    }
}

api GET "/customers/{id}" {
    handler get_customer
    input {
        id: CustomerId
    }
    output Customer
    errors {
        404 NotFound
    }
}

api POST "/customers" {
    input {
        name: String
        email: Email?
    }
    output Customer
    errors {
        400 ValidationError
    }
}

fn main() {
}
