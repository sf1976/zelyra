import "zelyra/ui" as ui

# The same Zelyra UI AppShell is used by every tutorial route and generated CRUD view.
pub view InvoiceTutorialShell {
    html {
        <!doctype html>
        <html data-z-ui data-zelyra-language>
            <head>
                <meta charset="utf-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1" />
                <title data-zelyra-i18n="invoice.nav.document_title">Invoice office · Zelyra</title>
            </head>
            <body>
                <AppShell id="invoice-app" navigation_label="Hauptnavigation">
                    <slot name="header">
                        <a class="tutorial-brand" href="/">
                            <span class="tutorial-brand-mark" aria-hidden="true">Z</span>
                            <span><strong>Rechnungsbüro</strong><small data-zelyra-i18n="invoice.nav.subtitle">Create invoices with ease</small></span>
                        </a>
                        <Dialog title="Quelltext verstehen" open_label="ⓘ Quelltext erklärt">
                            <div class="tutorial-source-help">
                                <p data-zelyra-i18n="invoice.source.intro">Diese Hilfe erklärt, welche Zelyra-Dateien die aktuelle Anwendung aufbauen. Die Links der Navigation öffnen echte Seiten; einige entstehen automatisch aus Deklarationen.</p>
                                <dl>
                                    <dt><code>main.zyl</code></dt>
                                <dd data-zelyra-i18n="invoice.source.main">Verbindet die Module und legt mit <code>page "/"</code> die Startseite ausdrücklich an.</dd>
                                    <dt><code>src/shell.zyl</code></dt>
                                    <dd data-zelyra-i18n="invoice.source.shell">Definiert den gemeinsamen AppShell mit Kopf, Navigation und Fußzeile. Eigene Seiten und generierte CRUD-Seiten verwenden dieses Layout.</dd>
                                    <dt><code>src/database.zyl</code></dt>
                                    <dd data-zelyra-i18n="invoice.source.database">Enthält die Tabellen- und Felddefinitionen. Daraus prüft Zelyra SQL-Abfragen und erzeugt das relationale Schema.</dd>
                                    <dt><code>src/customers.zyl</code> und <code>src/items.zyl</code></dt>
                                    <dd data-zelyra-i18n="invoice.source.catalogs">Die <code>crud</code>-Deklarationen erzeugen Listen, Suche, Formulare, Details und Aktionen für Kunden und Artikel.</dd>
                                    <dt><code>src/invoices.zyl</code></dt>
                                    <dd data-zelyra-i18n="invoice.source.invoices">Definiert Rechnungsfelder, Validierung und automatische Nummernvergabe. <code>crud Invoice -&gt; invoices</code> erzeugt unter anderem <code>/invoices</code> und <code>/invoices/new</code>.</dd>
                                    <dt><code>src/dashboard.zyl</code></dt>
                                    <dd data-zelyra-i18n="invoice.source.dashboard">Die typisierte SQL-Projektion und <code>tableview InvoiceDashboard</code> erzeugen die Rechnungsübersicht unter <code>/views/invoicedashboard</code>.</dd>
                                    <dt><code>zelyra.theme.css</code></dt>
                                    <dd data-zelyra-i18n="invoice.source.theme">Steuert Farben, Abstände und projektspezifische Komponentenstile zentral. Zelyra UI liefert die Basis; Anpassungen stehen in dieser Datei und brauchen weder CDN noch Frontend-Build.</dd>
                                </dl>
                                <p class="tutorial-source-help-next" data-zelyra-i18n="invoice.source.next">Öffne im Editor eine Quelldatei, um die Deklarationen zu sehen. Prüfe das Projekt mit <code>zelyra check main.zyl</code> und starte den Webserver mit <code>zelyra serve main.zyl</code>.</p>
                            </div>
                        </Dialog>
                        <a class="z-button z-button--primary tutorial-new-invoice" href="/invoices/new" data-zelyra-i18n="invoice.nav.new_invoice">+ New invoice</a>
                    </slot>
                    <slot name="navigation">
                        <a href="/" data-zelyra-i18n="invoice.nav.home">Home</a>
                        <a href="/customers" data-zelyra-i18n="invoice.nav.customers">Customers</a>
                        <a href="/items" data-zelyra-i18n="invoice.nav.items">Items</a>
                        <a href="/views/invoicedashboard" data-zelyra-i18n="invoice.nav.invoices">Invoice overview</a>
                        <a href="/invoice_lines" data-zelyra-i18n="invoice.nav.lines">Line items</a>
                        <a href="/ui/components">Zelyra UI</a>
                        <a href="/tour" data-zelyra-i18n="invoice.nav.tour">Code tour</a>
                    </slot>
                    <div class="tutorial-content"><slot /></div>
                    <slot name="footer">
                        <div data-zelyra-i18n="invoice.nav.footer">Local Zelyra example · Business data stays in your project environment</div>
                    </slot>
                </AppShell>
            </body>
        </html>
    }
}
