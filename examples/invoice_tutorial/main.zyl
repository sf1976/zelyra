# Connects business modules and the home page; Zelyra UI supplies shared CSS, while project-wide theme changes belong in zelyra.theme.css.
import "zelyra/ui" as ui
import "src/database.zyl" as storage
import "src/shell.zyl" as shell
import "src/customers.zyl" as customers
import "src/items.zyl" as items
import "src/invoices.zyl" as invoices
import "src/dashboard.zyl" as dashboard

page "/" {
    view: InvoiceTutorialShell
    html {
        <section class="invoice-home">
            <section class="invoice-home-hero-grid">
                <div class="invoice-home-hero">
                    <div class="invoice-home-kicker">
                        <span class="invoice-home-kicker-mark">Z</span>
                        <span data-zelyra-i18n="invoice.home.eyebrow">YOUR INVOICE WORKSPACE</span>
                        <span class="invoice-home-local" data-zelyra-i18n="invoice.home.local_badge">LOCAL & READY</span>
                    </div>
                    <h1 data-zelyra-i18n="invoice.home.title">From the first customer to the finished invoice.</h1>
                    <p class="invoice-home-intro" data-zelyra-i18n="invoice.home.intro">A complete invoice workflow, ready to explore with realistic sample data.</p>
                    <div class="invoice-home-actions">
                        <Button label="Create invoice" href="/invoices/new" appearance="success" translation_key="invoice.home.new_invoice" />
                        <Button label="Open invoice overview" href="/views/invoicedashboard" translation_key="invoice.home.overview" />
                        <Button label="Explore code tour" href="/tour" appearance="default" translation_key="invoice.home.tour_action" />
                    </div>
                    <div class="invoice-home-proof">
                        <span class="invoice-home-check">✓</span>
                        <span data-zelyra-i18n="invoice.home.proof">Your data stays in this local project.</span>
                    </div>
                </div>

                <aside class="invoice-preview">
                    <div class="invoice-preview-top">
                        <div>
                            <span class="invoice-preview-eyebrow" data-zelyra-i18n="invoice.home.sample_label">SAMPLE INVOICE</span>
                            <strong class="invoice-preview-number">RE-2026-001</strong>
                        </div>
                        <span class="invoice-preview-status" data-zelyra-i18n="invoice.home.sample_status">DRAFT</span>
                    </div>
                    <div class="invoice-preview-rule"></div>
                    <div class="invoice-preview-recipient">
                        <span data-zelyra-i18n="invoice.home.billed_to">BILLED TO</span>
                        <strong>Beispiel GmbH</strong>
                        <small>kontakt@beispiel.test</small>
                    </div>
                    <div class="invoice-preview-dates">
                        <div>
                            <span data-zelyra-i18n="invoice.home.issue_date">ISSUED ON</span>
                            <strong data-zelyra-i18n="invoice.home.sample_date">15 January 2026</strong>
                        </div>
                        <div>
                            <span data-zelyra-i18n="invoice.home.tax_rate">VAT RATE</span>
                            <strong data-zelyra-i18n="invoice.home.tax_rate_value">19%</strong>
                        </div>
                    </div>
                    <div class="invoice-preview-lines">
                        <div class="invoice-preview-line">
                            <div>
                                <strong data-zelyra-i18n="invoice.home.sample_item_1">Setup &amp; consulting</strong>
                                <small data-zelyra-i18n="invoice.home.sample_item_1_detail">2 × €125.00 net</small>
                            </div>
                            <strong data-zelyra-i18n="invoice.home.sample_amount_1">€250.00</strong>
                        </div>
                        <div class="invoice-preview-line">
                            <div>
                                <strong data-zelyra-i18n="invoice.home.sample_item_2">Monthly maintenance</strong>
                                <small data-zelyra-i18n="invoice.home.sample_item_2_detail">1 × €48.00 net</small>
                            </div>
                            <strong data-zelyra-i18n="invoice.home.sample_amount_2">€48.00</strong>
                        </div>
                    </div>
                    <div class="invoice-preview-total">
                        <div><span data-zelyra-i18n="invoice.home.net_total">Net total</span><strong data-zelyra-i18n="invoice.home.sample_net">€298.00</strong></div>
                        <div><span data-zelyra-i18n="invoice.home.tax_total">VAT · 19%</span><strong data-zelyra-i18n="invoice.home.sample_tax">€56.62</strong></div>
                        <div class="invoice-preview-grand-total"><span data-zelyra-i18n="invoice.home.gross_total">Amount due</span><strong data-zelyra-i18n="invoice.home.sample_gross">€354.62</strong></div>
                    </div>
                    <a class="invoice-preview-link" href="/invoices/RE-2026-001/print" data-zelyra-i18n="invoice.home.open_sample">Open printable example →</a>
                </aside>
            </section>

            <section class="invoice-home-highlights">
                <article class="invoice-highlight">
                    <span class="invoice-highlight-icon invoice-highlight-calendar">▦</span>
                    <div>
                        <strong data-zelyra-i18n="invoice.home.feature_date_title">A real calendar date</strong>
                        <p data-zelyra-i18n="invoice.home.feature_date_text">Enter a day, without typing a time.</p>
                    </div>
                </article>
                <article class="invoice-highlight">
                    <span class="invoice-highlight-icon invoice-highlight-number">#</span>
                    <div>
                        <strong data-zelyra-i18n="invoice.home.feature_number_title">Numbered for you</strong>
                        <p data-zelyra-i18n="invoice.home.feature_number_text">Each invoice gets its number when saved.</p>
                    </div>
                </article>
                <article class="invoice-highlight">
                    <span class="invoice-highlight-icon invoice-highlight-print">↗</span>
                    <div>
                        <strong data-zelyra-i18n="invoice.home.feature_print_title">Ready to print</strong>
                        <p data-zelyra-i18n="invoice.home.feature_print_text">Net, tax and total are calculated for you.</p>
                    </div>
                </article>
            </section>

            <section class="invoice-workflow">
                <div class="invoice-section-heading">
                    <div>
                        <span class="invoice-section-kicker" data-zelyra-i18n="invoice.home.workflow_kicker">THREE SIMPLE STEPS</span>
                        <h2 data-zelyra-i18n="invoice.home.workflow_title">Your next invoice starts here.</h2>
                    </div>
                    <a class="invoice-section-link" href="/views/invoicedashboard" data-zelyra-i18n="invoice.home.all_invoices">See all invoices →</a>
                </div>
                <Grid columns="three">
                    <article>
                        <div class="invoice-workflow-card">
                            <span class="invoice-step-number">01</span>
                            <span class="invoice-step-icon">◎</span>
                            <h3 data-zelyra-i18n="invoice.home.customer_title">Add a customer</h3>
                            <p data-zelyra-i18n="invoice.home.customer_text">Start with the person or company receiving the invoice.</p>
                            <a href="/customers/new" data-zelyra-i18n="invoice.home.customer_link">Add customer →</a>
                        </div>
                    </article>
                    <article>
                        <div class="invoice-workflow-card">
                            <span class="invoice-step-number">02</span>
                            <span class="invoice-step-icon">◇</span>
                            <h3 data-zelyra-i18n="invoice.home.item_title">Prepare an item</h3>
                            <p data-zelyra-i18n="invoice.home.item_text">Set a description and net price for your invoice line.</p>
                            <a href="/items/new" data-zelyra-i18n="invoice.home.item_link">Add item →</a>
                        </div>
                    </article>
                    <article>
                        <div class="invoice-workflow-card invoice-workflow-card-primary">
                            <span class="invoice-step-number">03</span>
                            <span class="invoice-step-icon">↗</span>
                            <h3 data-zelyra-i18n="invoice.home.invoice_title">Write an invoice</h3>
                            <p data-zelyra-i18n="invoice.home.invoice_text">Choose a customer. Zelyra assigns the invoice number automatically.</p>
                            <a href="/invoices/new" data-zelyra-i18n="invoice.home.invoice_link">Create your invoice →</a>
                        </div>
                    </article>
                </Grid>
            </section>

            <section class="invoice-tour-banner">
                <div class="invoice-tour-banner-inner">
                    <div class="invoice-tour-banner-text">
                        <span class="invoice-section-kicker" data-zelyra-i18n="invoice.home.code_title">ZELYRA QUELLTEXT-EINBLICK</span>
                        <h2>Wie funktioniert diese App im Quelltext?</h2>
                        <p>Verstehe den gesamten Code hinter Kunden, Artikeln, Rechnungen und Auswertungen. Keine versteckten Frameworks, kein Boilerplate.</p>
                    </div>
                    <div class="invoice-tour-banner-action">
                        <Button label="Interaktive Code-Tour starten →" href="/tour" appearance="success" />
                    </div>
                </div>
            </section>
        </section>
    }
}

page "/ui/components" {
    view: InvoiceTutorialShell
    html {
        <section class="invoice-ui-gallery">
            <PageHeader title="Zelyra UI – Komponenten" description="Geschäftsoberflächen mit geprüften Bausteinen, konsistenten Zuständen und lokal ausgelieferten Assets." />
            <Alert title="Darstellung und Validierung sind getrennt" appearance="warning">
                Die gewählte Erscheinung ändert keine Serverprüfung. aria-invalid kommt aus dem tatsächlichen Validierungszustand.
            </Alert>
            <Grid columns="two">
                <Card title="Semantische Varianten">
                    <Stack>
                        <Inline>
                            <Badge text="Standard" appearance="default" />
                            <Badge text="Erfolgreich" appearance="success" />
                            <Badge text="Prüfen" appearance="warning" />
                            <Badge text="Fehler" appearance="danger" />
                        </Inline>
                        <Button label="Bericht öffnen" href="/views/invoicedashboard" appearance="success" />
                        <Button label="Aktion ohne Formularübermittlung" appearance="default" />
                    </Stack>
                </Card>
                <Card title="Formularzustände">
                    <TextField id="ui-reference" name="reference" label="Referenz" appearance="success" required="true">
                        <slot name="hint">Die Gestaltung success markiert keinen Validierungserfolg.</slot>
                    </TextField>
                    <EmailField id="ui-email" name="email" label="E-Mail" appearance="danger" invalid="true">
                        <slot name="error">Diese Meldung wird vom Server geliefert.</slot>
                    </EmailField>
                    <form method="get" action="/ui/components">
                        <TextField id="ui-filter" name="filter" label="Beispielfilter" placeholder="z. B. offene Rechnungen" />
                        <FormActions><SubmitButton label="GET-Formular absenden" appearance="success" /></FormActions>
                    </form>
                </Card>
            </Grid>
            <Card title="Weitere native Formularfelder">
                <Fieldset legend="Auftrag erfassen">
                    <Grid columns="two">
                        <DateField id="ui-date" name="issued_at" label="Rechnungsdatum" required="true">
                            <slot name="hint">Der Browser zeigt den lokalen Datumsauswahldialog.</slot>
                        </DateField>
                        <NumberField id="ui-quantity" name="quantity" label="Menge" value="1" min="1" step="1" required="true" />
                        <SelectField id="ui-status" name="status" label="Status">
                            <option value="draft">Entwurf</option>
                            <option value="open">Offen</option>
                            <option value="paid">Bezahlt</option>
                        </SelectField>
                        <Textarea id="ui-note" name="note" label="Notiz" rows="3" />
                    </Grid>
                    <RadioGroup legend="Versandart">
                        <RadioField id="ui-delivery-email" name="delivery" value="email" label="E-Mail" checked="true" />
                        <RadioField id="ui-delivery-post" name="delivery" value="post" label="Post" />
                    </RadioGroup>
                    <Inline>
                        <CheckboxField id="ui-copy" name="copy" value="yes" label="Kopie ablegen" checked="true" />
                        <SwitchField id="ui-reminder" name="reminder" label="Zahlungserinnerung aktivieren" appearance="warning" />
                    </Inline>
                    <RadioGroup legend="Ausgabeformat">
                        <RadioField id="ui-format-pdf" name="format" value="pdf" label="PDF-Ansicht" checked="true" appearance="success" />
                        <RadioField id="ui-format-paper" name="format" value="paper" label="Papierdruck" appearance="default" />
                    </RadioGroup>
                </Fieldset>
            </Card>
            <Card title="Responsive Datentabelle">
                <DataTable caption="Beispielhafte Rechnungen">
                    <slot name="head"><tr><th scope="col">Nummer</th><th scope="col">Kunde</th><th scope="col">Status</th><th scope="col">Aktion</th></tr></slot>
                    <slot name="body"><tr><th scope="row">RE-2026-001</th><td>Beispiel GmbH</td><td><Badge text="Offen" appearance="warning" /></td><td><Link href="/views/invoicedashboard" label="Ansehen" /></td></tr></slot>
                </DataTable>
            </Card>
            <Grid columns="two">
                <BarChart title="Umsatz nach Monat" description="Beispielwerte; zugängliche Balken und Zahlenwerte.">
                    <ChartBar label="Januar" value="74" max="100" />
                    <ChartBar label="Februar" value="52" max="100" />
                    <ChartBar label="März" value="91" max="100" />
                </BarChart>
                <DonutChart id="invoice-paid-share" title="Bezahlte Rechnungen" description="Anteil an allen Beispielrechnungen" percentage="68">
                    <slot name="data"><p>68 Prozent bezahlt · 32 Prozent offen</p></slot>
                </DonutChart>
            </Grid>
            <Grid columns="two">
                <LineChart id="invoice-monthly-line" title="Rechnungsvolumen" description="Monatliche Beispielwerte; die Tabelle ist die Textalternative." points="5,45 35,28 65,34 95,10">
                    <slot name="data"><table><caption>Rechnungsvolumen nach Monat</caption><thead><tr><th scope="col">Monat</th><th scope="col">Rechnungen</th></tr></thead><tbody><tr><th scope="row">Januar</th><td>8</td></tr><tr><th scope="row">Februar</th><td>14</td></tr><tr><th scope="row">März</th><td>12</td></tr><tr><th scope="row">April</th><td>24</td></tr></tbody></table></slot>
                </LineChart>
                <Card title="Fortschritt und Navigation">
                    <Progress label="Monatsziel erreicht" value="68" max="100" />
                    <Breadcrumbs label="Beispielpfad"><li><a href="/">Start</a></li><li><a href="/invoices">Rechnungen</a></li><li aria-current="page">Auswertung</li></Breadcrumbs>
                    <Pagination label="Beispielseiten"><a class="z-button" href="/invoices?page=1">1</a><a class="z-button" href="/invoices?page=2">2</a></Pagination>
                </Card>
            </Grid>
            <Grid columns="two">
                <Card title="Zustände, Gruppen und Details">
                    <EmptyState id="ui-no-overdue" title="Keine überfälligen Rechnungen" description="Alle offenen Rechnungen liegen innerhalb ihrer Zahlungsfrist.">
                        <slot name="actions"><Button label="Rechnungen ansehen" href="/invoices" /></slot>
                    </EmptyState>
                    <LoadingState label="Bericht wird vorbereitet …" />
                    <ErrorState title="Bericht nicht verfügbar" message="Die gespeicherten Rechnungsdaten bleiben erhalten.">
                        <slot name="actions"><Button label="Erneut versuchen" href="/views/invoicedashboard" /></slot>
                    </ErrorState>
                    <ToastRegion><Toast message="Änderungen wurden lokal vorgemerkt." appearance="success" /></ToastRegion>
                    <ButtonGroup><Button label="Primäraktion" appearance="success" /><Button label="Abbrechen" href="/ui/components" /></ButtonGroup>
                    <Disclosure summary="Weitere Hinweise"><p>Native Details-Elemente bleiben ohne JavaScript bedienbar.</p></Disclosure>
                    <Dropdown label="Weitere Ansichten"><Link href="/customers" label="Kunden" /><Link href="/items" label="Artikel" /></Dropdown>
                </Card>
                <Card title="Tastaturbedienbare Tabs und Dialog">
                    <Tabs id="ui-reference-tabs" first_label="Zusammenfassung" second_label="Hinweise">
                        <slot name="first"><p>Die Pfeiltasten wechseln zwischen Tabs.</p></slot>
                        <slot name="second"><p>Ohne JavaScript funktionieren die Sprunglinks und beide Inhalte bleiben sichtbar.</p></slot>
                    </Tabs>
                    <Dialog title="Aktion prüfen" open_label="Dialog öffnen">
                        <p>Escape schließt den nativen Dialog und gibt den Fokus an die öffnende Schaltfläche zurück.</p>
                    </Dialog>
                </Card>
            </Grid>
            <Grid columns="two">
                <Disclosure summary="Mehr über Druck und PDF">
                    <p>Die Druckansicht verwendet den Browserdialog. Dort kann „Als PDF speichern“ gewählt werden. Zelyra erzeugt hier keine eigene PDF-Datei.</p>
                </Disclosure>
                <Card title="Weiterleiten per E-Mail">
                    <p>Diese Aktion öffnet den lokalen E-Mail-Client. Serverseitige Nachrichten werden ausdrücklich über mail_queue und den Outbox-Worker zugestellt.</p>
                    <EmailLink recipient="rechnung@example.test" subject="RE 2026&001" body="Rechnung RE 2026&001" label="E-Mail-Entwurf öffnen" />
                </Card>
            </Grid>
            <div class="z-no-print"><PrintAction label="Komponentenübersicht drucken" /></div>
        </section>
    }
}

page "/tour" {
    view: InvoiceTutorialShell
    html {
        <section class="tutorial-tour-page">
            <PageHeader title="Zelyra Architektur- &amp; Code-Tour" description="Vollständige Geschäftsanwendung in unter 200 Zeilen deklarativem Code – ohne JavaScript-Frameworks, ohne ORM, ohne Build-Tools." />

            <Grid columns="two">
                <Card title="Der Zelyra-Weg: Deklarativ &amp; Integriert">
                    <p>Zelyra vereint Datenbankschema, Logik und Oberfläche in einer einzigen typsicheren Sprache.</p>
                    <ul class="tutorial-feature-list">
                        <li><strong>100% Typensicherheit:</strong> Vom Datenbankschema über SQL bis ins HTML-Template prüft der Compiler alles vor dem Start.</li>
                        <li><strong>0 Build-Schritt:</strong> Keine package.json, kein Webpack/Vite, keine 500 MB Fremdpakete.</li>
                        <li><strong>0 API-Boilerplate:</strong> Keine DTOs, Serializer, REST-Controller oder Endpunkt-Glue.</li>
                        <li><strong>Volle Datensouveränität:</strong> Läuft lokal auf deinem Rechner mit echter MariaDB.</li>
                    </ul>
                </Card>
                <Card title="Klassischer Web-Stack: Zersplittert &amp; Aufwendig">
                    <p>Herkömmliche Architekturen erfordern Dutzende Werkzeuge und redundanten Code.</p>
                    <ul class="tutorial-feature-list">
                        <li><strong>Backend-Schichten:</strong> ORM-Modelle, Migrations-Dateien, Controller, Serializer und Validatoren.</li>
                        <li><strong>Frontend-Schichten:</strong> React/Vue/Angular, State-Management (Redux/Pinia), Router und API-Clients.</li>
                        <li><strong>Typ-Brüche:</strong> Datenbank-Spalten, JSON-Payloads und TypeScript-Typen müssen manuell synchron gehalten werden.</li>
                        <li><strong>Hohe Komplexität:</strong> Tausende Fremdpakete und ständige Sicherheitsaktualisierungen.</li>
                    </ul>
                </Card>
            </Grid>

            <Card title="1. Kundenverwaltung in nur 18 Zeilen (src/customers.zyl)">
                <p>Eine Tabelle und eine CRUD-Deklaration genügen. Zelyra erzeugt automatisch responsive Karten, Suchfunktion und Formulare.</p>
                <Disclosure summary="Quelltext von src/customers.zyl anzeigen">
                    <div class="tutorial-code-block">
                        <div class="tutorial-code-header">
                            <span>src/customers.zyl</span>
                            <span class="tutorial-code-badge">Tabelle + CRUD</span>
                        </div>
                        <pre class="tutorial-code-body"><code>table customers &#123;
    id: Id primary auto
    name: String(120) required
    email: Email?
    access &#123;
        read: [&quot;src/invoices.zyl&quot;, &quot;src/dashboard.zyl&quot;, &quot;main.zyl&quot;]
    &#125;
&#125;

crud Customer -&gt; customers &#123;
    layout: InvoiceTutorialShell
    title: &quot;Kunden&quot;
    view &#123;
        fields &#123; name email &#125;
        list &#123; mode: cards &#125;
        detail &#123; mode: cards &#125;
        form &#123; mode: cards &#125;
    &#125;
    list &#123; name email &#125;
    search &#123; name email &#125;
&#125;</code></pre>
                    </div>
                </Disclosure>
                <ButtonGroup>
                    <Button label="Kundenverwaltung live öffnen" href="/customers" appearance="success" />
                </ButtonGroup>
            </Card>

            <Card title="2. Artikelkatalog mit Preisen &amp; Filter (src/items.zyl)">
                <p>Exakte Dezimal-Arithmetik für Geldbeträge (Decimal) und boolesche Filter ohne eine Zeile JavaScript.</p>
                <Disclosure summary="Quelltext von src/items.zyl anzeigen">
                    <div class="tutorial-code-block">
                        <div class="tutorial-code-header">
                            <span>src/items.zyl</span>
                            <span class="tutorial-code-badge">Dezimalpreise &amp; Filter</span>
                        </div>
                        <pre class="tutorial-code-body"><code>table items &#123;
    id: Id primary auto
    sku: String(40) required unique
    name: String(120) required
    unit_price: Decimal required
    active: Bool default true
    access &#123;
        read: [&quot;src/invoices.zyl&quot;, &quot;src/dashboard.zyl&quot;]
    &#125;
&#125;

crud Item -&gt; items &#123;
    layout: InvoiceTutorialShell
    title: &quot;Artikel&quot;
    view &#123;
        fields &#123; sku name unit_price active &#125;
        list &#123; mode: cards &#125;
    &#125;
    list &#123; sku name unit_price active &#125;
    search &#123; sku name &#125;
    filter &#123; active &#125;
&#125;</code></pre>
                    </div>
                </Disclosure>
                <ButtonGroup>
                    <Button label="Artikelkatalog live öffnen" href="/items" appearance="success" />
                </ButtonGroup>
            </Card>

            <Card title="3. Rechnungen &amp; Positionen mit Relationen (src/invoices.zyl)">
                <p>Typgesicherte Relationen: customer verweist direkt auf Customer, Fremdschlüssel und Nullability werden vom Compiler garantiert.</p>
                <Disclosure summary="Quelltext von src/invoices.zyl anzeigen">
                    <div class="tutorial-code-block">
                        <div class="tutorial-code-header">
                            <span>src/invoices.zyl</span>
                            <span class="tutorial-code-badge">Relationen &amp; Typisierung</span>
                        </div>
                        <pre class="tutorial-code-body"><code>table invoices &#123;
    id: Id primary auto
    invoice_number: String(40) required unique
    customer: customers::Customer required
    issued_at: Date required default now
    status: String(20) default &quot;draft&quot;
&#125;

table invoice_lines &#123;
    id: Id primary auto
    invoice: Invoice required
    item: items::Item required
    quantity: Int required
    unit_price: Decimal required
&#125;

crud Invoice -&gt; invoices &#123;
    layout: InvoiceTutorialShell
    title: &quot;Rechnungsübersicht&quot;
    list &#123; invoice_number customer issued_at status &#125;
    search &#123; invoice_number status &#125;
    filter &#123; status &#125;
&#125;</code></pre>
                    </div>
                </Disclosure>
                <ButtonGroup>
                    <Button label="Rechnung erstellen" href="/invoices/new" appearance="success" />
                    <Button label="Rechnungsliste ansehen" href="/invoices" appearance="default" />
                </ButtonGroup>
            </Card>

            <Card title="4. Live-Dashboard mit SQL-Aggregation (src/dashboard.zyl)">
                <p>Eine SQL-Abfrage berechnet Netto-, Steuer- und Bruttobetrag serverseitig. Die TableView übernimmt Sortierung, Suche und Pagination.</p>
                <Disclosure summary="Quelltext von src/dashboard.zyl anzeigen">
                    <div class="tutorial-code-block">
                        <div class="tutorial-code-header">
                            <span>src/dashboard.zyl</span>
                            <span class="tutorial-code-badge">SQL-Projektion &amp; TableView</span>
                        </div>
                        <pre class="tutorial-code-body"><code>tableview InvoiceDashboard &#123;
    layout: InvoiceTutorialShell
    source sql&lt;InvoiceDashboardRow[]&gt; &#123;
        SELECT
            invoices.id,
            invoices.invoice_number,
            customers.name AS customer_name,
            invoices.status,
            ROUND(COALESCE(SUM(invoice_lines.quantity * invoice_lines.unit_price), 0), 2) AS net_total,
            ROUND(COALESCE(SUM(invoice_lines.quantity * invoice_lines.unit_price), 0) * 0.19, 2) AS tax_amount,
            ROUND(COALESCE(SUM(invoice_lines.quantity * invoice_lines.unit_price), 0) * 1.19, 2) AS gross_total
        FROM invoices
        JOIN customers ON customers.id = invoices.customer_id
        LEFT JOIN invoice_lines ON invoice_lines.invoice_id = invoices.id
        GROUP BY invoices.id, invoices.invoice_number, customers.name, invoices.status
    &#125;
    columns &#123; id invoice_number customer_name status net_total tax_amount gross_total &#125;
    filter &#123; status &#125;
    searchable
    sortable
    paginated 20
&#125;</code></pre>
                    </div>
                </Disclosure>
                <ButtonGroup>
                    <Button label="Rechnungs-Dashboard live öffnen" href="/views/invoicedashboard" appearance="success" />
                </ButtonGroup>
            </Card>

            <Card title="5. Druckbare Rechnung mit 19% MwSt. (/invoices/RE-2026-001/print)">
                <p>Druckoptimiertes Layout: Verwendet den nativen Browser-Druckdialog und rendert Positionen direkt über typsichere Template-Schleifen.</p>
                <ButtonGroup>
                    <Button label="Beispielrechnung RE-2026-001 öffnen" href="/invoices/RE-2026-001/print" appearance="success" />
                </ButtonGroup>
            </Card>
        </section>
    }
}

