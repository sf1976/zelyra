# This is the project entry point. Business areas are kept in src/ modules.
import "src/database.zyl" as storage
import "src/shell.zyl" as shell
import "src/customers.zyl" as customers
import "src/items.zyl" as items
import "src/invoices.zyl" as invoices
import "src/dashboard.zyl" as dashboard

struct InvoiceOverview {
    customer_count: Int
    invoice_count: Int
    net_total: Decimal
    tax_total: Decimal
    gross_total: Decimal
}

page "/" {
    view: InvoiceTutorialShell
    load overview = sql<InvoiceOverview> {
        SELECT
            COUNT(DISTINCT customers.id) AS customer_count,
            COUNT(DISTINCT invoices.id) AS invoice_count,
            ROUND(COALESCE(SUM(invoice_lines.quantity * invoice_lines.unit_price), 0), 2) AS net_total,
            ROUND(COALESCE(SUM(invoice_lines.quantity * invoice_lines.unit_price), 0) * 0.19, 2) AS tax_total,
            ROUND(COALESCE(SUM(invoice_lines.quantity * invoice_lines.unit_price), 0) * 1.19, 2) AS gross_total
        FROM customers
        LEFT JOIN invoices ON invoices.customer_id = customers.id
        LEFT JOIN invoice_lines ON invoice_lines.invoice_id = invoices.id
    }
    html {
        <div class="page-header tutorial-page-header">
            <div>
                <p class="text-secondary text-uppercase tutorial-eyebrow">
                    Dein Unternehmen auf einen Blick
                </p>
                <h1 class="page-title">Guten Tag im Rechnungsbüro</h1>
                <p class="text-secondary">
                    Kunden, Artikel und Rechnungen greifen in einem nachvollziehbaren Ablauf ineinander.
                </p>
            </div>
            <div class="tutorial-header-actions">
                <a class="btn btn-outline-secondary" href="/views/invoicedashboard">
                    Rechnungsliste ansehen
                </a>
                <a class="btn btn-primary" href="/invoices/new">
                    Rechnung schreiben
                </a>
            </div>
        </div>

        <section class="row row-cards tutorial-metrics" aria-label="Geschäftszahlen">
            <div class="col-sm-6 col-xl-3">
                <article class="card tutorial-metric">
                    <div class="card-body">
                        <span class="tutorial-metric-icon">K</span>
                        <p class="text-secondary">Kunden</p>
                        <strong>{overview.customer_count}</strong>
                        <a href="/customers">Kunden verwalten →</a>
                    </div>
                </article>
            </div>
            <div class="col-sm-6 col-xl-3">
                <article class="card tutorial-metric">
                    <div class="card-body">
                        <span class="tutorial-metric-icon">R</span>
                        <p class="text-secondary">Rechnungen</p>
                        <strong>{overview.invoice_count}</strong>
                        <a href="/invoices">Alle Rechnungen →</a>
                    </div>
                </article>
            </div>
            <div class="col-sm-6 col-xl-3">
                <article class="card tutorial-metric">
                    <div class="card-body">
                        <span class="tutorial-metric-icon">N</span>
                        <p class="text-secondary">Erfasster Nettowert</p>
                        <strong>{overview.net_total} €</strong>
                        <small>Summe gespeicherter Positionen, auch aus Entwürfen</small>
                    </div>
                </article>
            </div>
            <div class="col-sm-6 col-xl-3">
                <article class="card tutorial-metric tutorial-metric-accent">
                    <div class="card-body">
                        <span class="tutorial-metric-icon">€</span>
                        <p class="text-secondary">Erfasster Bruttowert</p>
                        <strong>{overview.gross_total} €</strong>
                        <small>inklusive 19 % Umsatzsteuer · {overview.tax_total} €</small>
                    </div>
                </article>
            </div>
        </section>

        <section class="row tutorial-workspace">
            <div class="col-xl-8">
                <article class="card tutorial-card tutorial-flow-card">
                    <div class="card-header">
                        <div>
                            <p class="tutorial-eyebrow">Der einfache Ablauf</p>
                            <h2 class="card-title">Von Kundendaten zur fertigen Rechnung</h2>
                        </div>
                        <span class="badge bg-green-lt">4 Schritte</span>
                    </div>
                    <div class="card-body">
                        <ol class="tutorial-steps">
                            <li>
                                <span>1</span>
                                <div>
                                    <strong>Kunden erfassen</strong>
                                    <p>Lege Name und Kontaktdaten an. Der Kunde wird später direkt der Rechnung zugeordnet.</p>
                                    <a href="/customers/new">Kundenformular öffnen →</a>
                                </div>
                            </li>
                            <li>
                                <span>2</span>
                                <div>
                                    <strong>Artikel vorbereiten</strong>
                                    <p>Speichere Artikelnummer, Beschreibung und Nettopreis einmal und verwende sie wieder.</p>
                                    <a href="/items/new">Artikel erfassen →</a>
                                </div>
                            </li>
                            <li>
                                <span>3</span>
                                <div>
                                    <strong>Rechnung schreiben</strong>
                                    <p>Wähle den Kunden, ergänze Rechnungspositionen und prüfe den Status.</p>
                                    <a href="/invoices/new">Neue Rechnung anlegen →</a>
                                </div>
                            </li>
                            <li>
                                <span>4</span>
                                <div>
                                    <strong>Als PDF ausgeben</strong>
                                    <p>Die Druckansicht weist Netto, 19 % Umsatzsteuer und Brutto aus. Im Browser kannst du „Als PDF speichern“ wählen.</p>
                                    <a href="/views/invoicedashboard">Rechnungen und Summen ansehen →</a>
                                </div>
                            </li>
                        </ol>
                    </div>
                </article>
            </div>
            <div class="col-xl-4">
                <article class="card tutorial-card tutorial-side-card">
                    <div class="card-header">
                        <div>
                            <p class="tutorial-eyebrow">Deine Daten</p>
                            <h2 class="card-title">Alles miteinander verbunden</h2>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="tutorial-relation">
                            <span class="tutorial-relation-icon">01</span>
                            <div><strong>Kunde</strong><small>hat mehrere Rechnungen</small></div>
                        </div>
                        <div class="tutorial-relation-line"></div>
                        <div class="tutorial-relation">
                            <span class="tutorial-relation-icon">02</span>
                            <div><strong>Rechnung</strong><small>gehört zu einem Kunden</small></div>
                        </div>
                        <div class="tutorial-relation-line"></div>
                        <div class="tutorial-relation">
                            <span class="tutorial-relation-icon">03</span>
                            <div><strong>Positionen</strong><small>verknüpfen Rechnung und Artikel</small></div>
                        </div>
                        <div class="tutorial-help">
                            <strong>Einsteiger-Tipp</strong>
                            <p>Beginne links mit einem Kunden. In jedem Formular kannst du gespeicherte Datensätze aus den verknüpften Tabellen auswählen.</p>
                        </div>
                    </div>
                </article>
                <article class="card tutorial-card tutorial-total-card">
                    <div class="card-body">
                        <span class="badge bg-blue-lt">Steuerübersicht</span>
                        <h2>19 % Umsatzsteuer</h2>
                        <p>Die Summen enthalten auch Entwürfe und sind keine gebuchte Umsatzstatistik. Die Beispielrechnung weist Netto, Steuer und Brutto getrennt aus.</p>
                        <a href="/invoices">Zur Rechnungsliste →</a>
                    </div>
                </article>
            </div>
        </section>
    }
}
