# This file gathers the business modules and defines the landing page.
import "src/database.zyl" as storage
import "src/shell.zyl" as shell
import "src/customers.zyl" as customers
import "src/items.zyl" as items
import "src/invoices.zyl" as invoices
import "src/dashboard.zyl" as dashboard

page "/" {
    view: InvoiceTutorialShell
    html {
        <main class="invoice-home">
            <section class="card invoice-home-hero">
                <p class="text-secondary text-uppercase" data-zelyra-i18n="invoice.home.eyebrow">Manage invoices simply</p>
                <h1 data-zelyra-i18n="invoice.home.title">What would you like to do?</h1>
                <p data-zelyra-i18n="invoice.home.intro">Add customers and items, create an invoice, then open the invoice overview.</p>
                <div class="invoice-home-actions">
                    <a class="btn btn-primary" href="/invoices/new" data-zelyra-i18n="invoice.home.new_invoice">Create invoice</a>
                    <a class="btn btn-outline-secondary" href="/views/invoicedashboard" data-zelyra-i18n="invoice.home.overview">Open invoice overview</a>
                </div>
            </section>

            <section class="row row-cards">
                <article class="col-md-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <span class="badge bg-blue-lt">01</span>
                            <h2 data-zelyra-i18n="invoice.home.customer_title">Add a customer</h2>
                            <p data-zelyra-i18n="invoice.home.customer_text">Start by adding the recipient and their contact details.</p>
                            <a href="/customers/new" data-zelyra-i18n="invoice.home.customer_link">Open customer form →</a>
                        </div>
                    </div>
                </article>
                <article class="col-md-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <span class="badge bg-azure-lt">02</span>
                            <h2 data-zelyra-i18n="invoice.home.item_title">Prepare an item</h2>
                            <p data-zelyra-i18n="invoice.home.item_text">Save an item number and net price so you can select it for invoice lines.</p>
                            <a href="/items/new" data-zelyra-i18n="invoice.home.item_link">Add an item →</a>
                        </div>
                    </div>
                </article>
                <article class="col-md-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <span class="badge bg-green-lt">03</span>
                            <h2 data-zelyra-i18n="invoice.home.invoice_title">Write an invoice</h2>
                            <p data-zelyra-i18n="invoice.home.invoice_text">Choose a customer. Zelyra assigns the invoice number automatically.</p>
                            <a href="/invoices/new" data-zelyra-i18n="invoice.home.invoice_link">Open invoice form →</a>
                        </div>
                    </div>
                </article>
            </section>
        </main>
    }
}
