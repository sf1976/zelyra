import "zelyra/ui" as ui

database main {
    engine: mariadb
}

view StarterShell {
    html {
        <!doctype html>
        <html data-z-ui data-zelyra-language>
            <head>
                <meta charset="utf-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1" />
                <title data-zelyra-i18n="starter.document_title"></title>
            </head>
            <body>
                <AppShell id="starter" navigation_label="Navigation">
                    <slot name="header">
                        <strong>Zelyra</strong>
                        <span data-zelyra-i18n="starter.brand_descriptor"></span>
                    </slot>
                    <slot name="navigation">
                        <a href="/" data-zelyra-i18n="starter.nav_overview"></a>
                    </slot>
                    <slot name="footer">
                        <span data-zelyra-i18n="starter.connection_status"></span>
                    </slot>
                    <slot />
                </AppShell>
            </body>
        </html>
    }
}

page "/" {
    view: StarterShell
    html {
        <Container>
            <PageHeader
                title="@i18n:starter.workspace_title"
                description="@i18n:starter.workspace_description"
            />
            <Card title="@i18n:starter.home_title">
                <p data-zelyra-i18n="starter.home_description"></p>
                <h2 data-zelyra-i18n="starter.steps_title"></h2>
                <ol>
                    <li>
                        <strong data-zelyra-i18n="starter.step_model_title"></strong>
                        <p data-zelyra-i18n="starter.step_model_description"></p>
                        <code>id: Id primary auto</code>
                    </li>
                    <li>
                        <strong data-zelyra-i18n="starter.step_check_title"></strong>
                        <p data-zelyra-i18n="starter.step_check_description"></p>
                        <code>zelyra check main.zyl</code>
                    </li>
                    <li>
                        <strong data-zelyra-i18n="starter.step_run_title"></strong>
                        <p data-zelyra-i18n="starter.step_run_description"></p>
                        <code>zelyra serve main.zyl</code>
                    </li>
                </ol>
            </Card>
        </Container>
    }
}
