database main {
    engine: mariadb
}

table customers {
    id: Id primary auto
    name: String(100) required
}

page "/customers" {
    search {
        name
    }

    filter {
        name
    }

    sort {
        name
    }

    paginated 25

    load customers = sql<Customer[]> {
        SELECT id, name
        FROM customers
        ORDER BY name
    }

    html {
        <h1>Kunden</h1>
        <p>Seite {page} von {pages}, Datensätze: {total}</p>
        <ul>
            for customer in customers {
                <li>{customer.name}</li>
            }
        </ul>
    }
}
