database main {
    engine: mariadb
}

table customers {
    id: Id primary auto
    name: String(100) required
}

page "/customers" {
    search {
        name
    }

    filter {
        name
    }

    sort {
        name
    }

    paginated 25

    load customers = sql<Customer[]> {
        SELECT id, name
        FROM customers
        ORDER BY name
    }

    html {
        <form method="get">
            <input name="search" value="{search}" />
            <input name="page" value="{page}" />
            <input name="sort" value="{sort}" />
            <input name="order" value="{order}" />
            <input name="filter_name" value="{filter_name}" />
            <input name="filter_name__operator" value="{filter_name__operator}" />
            <button type="submit">Suchen</button>
        </form>
        <ul>
            for customer in customers {
                <li>{customer.name}</li>
            }
        </ul>
    }
}
