import "pkg:billing" as billing
import "pkg:csv_export" as csv_export
import "pkg:csv_import" as csv_import

page "/" {
    html {
        <h1>Business module application</h1>
        <p>Billing, storage, and CSV tools are composed from reusable packages.</p>
    }
}

fn csv_demo() {
    rows = [["number", "customer", "note"], ["INV-1", "Acme, Inc.", "Paid\nby transfer"]]
    match csv_export::encode(rows) {
        Ok(contents) => { print(contents) }
        Err(message) => { print(message) }
    }
}

fn csv_import_demo() {
    source_text = "number;customer\nINV-1;Acme GmbH"
    match csv_import::decode_table(source_text, ';') {
        Ok(rows) => {
            print(len(rows))
            print(rows[1][1])
            match csv_import::preview_table(rows, 1) {
                Ok(preview) => { print(len(preview)) }
                Err(message) => { print(message) }
            }
            match csv_import::map_columns(rows, ["customer", "number"], ["customer_name", "invoice_number"]) {
                Ok(mapped) => {
                    print(mapped[0][0])
                    print(mapped[1][0])
                    print(mapped[1][1])
                }
                Err(message) => { print(message) }
            }
        }
        Err(message) => { print(message) }
    }

    match csv_import::preview_table([["number", "customer"], ["INV-1", "Acme GmbH"]], 101) {
        Ok(_) => { print("unexpected CSV preview success") }
        Err(message) => { print(message) }
    }

    match csv_import::map_columns([["number", "customer"], ["INV-1", "Acme GmbH"]], ["missing"], ["invoice_number"]) {
        Ok(_) => { print("unexpected CSV mapping success") }
        Err(message) => { print(message) }
    }

    match csv_import::map_columns([["number", "number"], ["INV-1", "INV-1"]], ["number"], ["invoice_number"]) {
        Ok(_) => { print("unexpected ambiguous CSV mapping success") }
        Err(message) => { print(message) }
    }

    match csv_import::map_columns([["number", "customer"], ["INV-1", "Acme GmbH"]], ["number", "customer"], ["value", "value"]) {
        Ok(_) => { print("unexpected duplicate CSV target success") }
        Err(message) => { print(message) }
    }

    match csv_import::decode_table("name;email\nAnna", ';') {
        Ok(_) => { print("unexpected CSV import success") }
        Err(message) => { print(message) }
    }

    match csv_import::decode_table("name;;email\nAnna;anna@example.test;anna@example.test", ';') {
        Ok(_) => { print("unexpected CSV import success") }
        Err(message) => { print(message) }
    }
}

fn csv_convert_demo() {
    source_text = "number;quantity;active;note;amount\nINV-1;2;true;first;12.34\nINV-2;0;0;;0"
    mappings: csv_import::CsvColumnMapping[] = [
        csv_import::CsvColumnMapping { source_name: "number", target_name: "invoice_number", value_type: csv_import::CsvColumnType::Text },
        csv_import::CsvColumnMapping { source_name: "quantity", target_name: "quantity", value_type: csv_import::CsvColumnType::Integer },
        csv_import::CsvColumnMapping { source_name: "active", target_name: "active", value_type: csv_import::CsvColumnType::Boolean },
        csv_import::CsvColumnMapping { source_name: "note", target_name: "note", value_type: csv_import::CsvColumnType::Text },
        csv_import::CsvColumnMapping { source_name: "amount", target_name: "amount", value_type: csv_import::CsvColumnType::Decimal }
    ]
    match csv_import::decode_table(source_text, ';') {
        Ok(rows) => {
            match csv_import::convert_columns(rows, mappings) {
                Ok(converted) => {
                    print(converted.column_names[0])
                    match converted.rows[0][0] {
                        csv_import::CsvValue::Text(value) => { print(value) }
                        csv_import::CsvValue::Integer(_) => { print("unexpected integer") }
                        csv_import::CsvValue::Boolean(_) => { print("unexpected boolean") }
                        csv_import::CsvValue::Decimal(_) => { print("unexpected decimal") }
                        csv_import::CsvValue::Date(_) => { print("unexpected date") }
                        csv_import::CsvValue::Time(_) => { print("unexpected time") }
                    }
                    match converted.rows[0][1] {
                        csv_import::CsvValue::Text(_) => { print("unexpected text") }
                        csv_import::CsvValue::Integer(value) => { print(value) }
                        csv_import::CsvValue::Boolean(_) => { print("unexpected boolean") }
                        csv_import::CsvValue::Decimal(_) => { print("unexpected decimal") }
                        csv_import::CsvValue::Date(_) => { print("unexpected date") }
                        csv_import::CsvValue::Time(_) => { print("unexpected time") }
                    }
                    match converted.rows[0][2] {
                        csv_import::CsvValue::Text(_) => { print("unexpected text") }
                        csv_import::CsvValue::Integer(_) => { print("unexpected integer") }
                        csv_import::CsvValue::Boolean(value) => { print(value) }
                        csv_import::CsvValue::Decimal(_) => { print("unexpected decimal") }
                        csv_import::CsvValue::Date(_) => { print("unexpected date") }
                        csv_import::CsvValue::Time(_) => { print("unexpected time") }
                    }
                    match converted.rows[1][3] {
                        csv_import::CsvValue::Text(value) => { print("empty note length " + to_string(len(value))) }
                        csv_import::CsvValue::Integer(_) => { print("unexpected integer") }
                        csv_import::CsvValue::Boolean(_) => { print("unexpected boolean") }
                        csv_import::CsvValue::Decimal(_) => { print("unexpected decimal") }
                        csv_import::CsvValue::Date(_) => { print("unexpected date") }
                        csv_import::CsvValue::Time(_) => { print("unexpected time") }
                    }
                    match converted.rows[0][4] {
                        csv_import::CsvValue::Text(_) => { print("unexpected text") }
                        csv_import::CsvValue::Integer(_) => { print("unexpected integer") }
                        csv_import::CsvValue::Boolean(_) => { print("unexpected boolean") }
                        csv_import::CsvValue::Decimal(value) => { print(value) }
                        csv_import::CsvValue::Date(_) => { print("unexpected date") }
                        csv_import::CsvValue::Time(_) => { print("unexpected time") }
                    }
                }
                Err(message) => { print(message) }
            }
        }
        Err(message) => { print(message) }
    }

    invalid_rows = [["quantity"], ["2.5"]]
    invalid_mappings: csv_import::CsvColumnMapping[] = [
        csv_import::CsvColumnMapping { source_name: "quantity", target_name: "quantity", value_type: csv_import::CsvColumnType::Integer }
    ]
    match csv_import::convert_columns(invalid_rows, invalid_mappings) {
        Ok(_) => { print("unexpected typed CSV conversion success") }
        Err(message) => { print(message) }
    }

    invalid_decimal_rows = [["amount"], ["12.3456789012"]]
    invalid_decimal_mappings: csv_import::CsvColumnMapping[] = [
        csv_import::CsvColumnMapping { source_name: "amount", target_name: "amount", value_type: csv_import::CsvColumnType::Decimal }
    ]
    match csv_import::convert_columns(invalid_decimal_rows, invalid_decimal_mappings) {
        Ok(_) => { print("unexpected decimal conversion success") }
        Err(message) => { print(message) }
    }
}

fn csv_temporal_demo() {
    rows = [["invoice_date", "sent_at"], ["2024-02-29", "09:15:30"]]
    mappings: csv_import::CsvColumnMapping[] = [
        csv_import::CsvColumnMapping { source_name: "invoice_date", target_name: "invoice_date", value_type: csv_import::CsvColumnType::Date },
        csv_import::CsvColumnMapping { source_name: "sent_at", target_name: "sent_at", value_type: csv_import::CsvColumnType::Time }
    ]
    match csv_import::convert_columns(rows, mappings) {
        Ok(converted) => {
            match converted.rows[0][0] {
                csv_import::CsvValue::Date(value) => { print(value) }
                _ => { print("unexpected date conversion") }
            }
            match converted.rows[0][1] {
                csv_import::CsvValue::Time(value) => { print(value) }
                _ => { print("unexpected time conversion") }
            }
        }
        Err(message) => { print(message) }
    }

    invalid_rows = [["invoice_date"], ["2023-02-29"]]
    invalid_mappings: csv_import::CsvColumnMapping[] = [
        csv_import::CsvColumnMapping { source_name: "invoice_date", target_name: "invoice_date", value_type: csv_import::CsvColumnType::Date }
    ]
    match csv_import::convert_columns(invalid_rows, invalid_mappings) {
        Ok(_) => { print("unexpected invalid date conversion success") }
        Err(message) => { print(message) }
    }

    invalid_time_rows = [["sent_at"], ["09:15"]]
    invalid_time_mappings: csv_import::CsvColumnMapping[] = [
        csv_import::CsvColumnMapping { source_name: "sent_at", target_name: "sent_at", value_type: csv_import::CsvColumnType::Time }
    ]
    match csv_import::convert_columns(invalid_time_rows, invalid_time_mappings) {
        Ok(_) => { print("unexpected invalid time conversion success") }
        Err(message) => { print(message) }
    }
}

fn billing_calculation_demo() {
    amounts = billing::calculate_line_amounts(
        decimal("3"),
        decimal("0.05"),
        decimal("0.19"),
        2,
        "half_even"
    )
    match amounts {
        Ok(value) => {
            assert(value.net == decimal("0.15"), "net total uses explicit scale")
            assert(value.tax == decimal("0.03"), "tax uses explicit rounding")
            assert(value.gross == decimal("0.18"), "gross is the rounded net plus rounded tax")
            print("net=0.15 tax=0.03 gross=0.18")
        }
        Err(message) => { print(message) }
    }

    // The same package API also prices a quote line; the package does not
    // distinguish document types or choose the caller's tax policy.
    quote_line = billing::calculate_line_amounts(
        decimal("4"),
        decimal("12.50"),
        decimal("0.20"),
        2,
        "half_even"
    )
    match quote_line {
        Ok(value) => {
            assert(value.net == decimal("50.00"), "quote net is calculated by the shared line API")
            assert(value.tax == decimal("10.00"), "quote tax uses the caller's fraction")
            assert(value.gross == decimal("60.00"), "quote gross uses the same shared calculation")
            print("quote=net:50.00 tax:10.00 gross:60.00")
        }
        Err(message) => { print(message) }
    }

    invalid_mode = billing::calculate_line_amounts(
        decimal("1"),
        decimal("1.005"),
        decimal("0"),
        2,
        "unknown"
    )
    match invalid_mode {
        Ok(_) => { print("unexpected rounding mode success") }
        Err(message) => { print(message) }
    }
}

fn main() uses Database(read) {
    print(billing::invoice_count())
}
