pub fn decode_table(source_text: String, delimiter: Char) -> Result<String[][], String> {
    match csv_decode_result(source_text, delimiter) {
        Ok(rows) => {
            if len(rows) == 0 {
                return Err("CSV input must contain a header row")
            }
            headers = rows[0]
            if len(headers) == 0 {
                return Err("CSV header row must contain at least one column")
            }
            mutable header_number = 0
            for header in headers {
                header_number = header_number + 1
                if header == "" {
                    return Err("CSV header column " + to_string(header_number) + " is empty")
                }
            }
            mutable row_number = 0
            for row in rows {
                row_number = row_number + 1
                if len(row) != len(headers) {
                    return Err("CSV row " + to_string(row_number) + " has a different number of columns than the header")
                }
            }
            return Ok(rows)
        }
        Err(message) => { return Err(message) }
    }
}

/// Return a bounded preview containing the header and at most `max_rows` data rows.
/// The limit is intentionally capped so the preview remains suitable for a UI.
pub fn preview_table(rows: String[][], max_rows: Int) -> Result<String[][], String> {
    if len(rows) == 0 {
        return Err("CSV preview requires a header row")
    }
    if max_rows < 0 || max_rows > 100 {
        return Err("CSV preview row limit must be between 0 and 100")
    }
    headers = rows[0]
    mutable preview: String[][] = [headers]
    mutable row_index = 1
    mutable copied = 0
    while row_index < len(rows) && copied < max_rows {
        if len(rows[row_index]) != len(headers) {
            return Err("CSV preview contains a row with a different number of columns than the header")
        }
        preview = append(preview, rows[row_index])
        row_index = row_index + 1
        copied = copied + 1
    }
    return Ok(preview)
}

/// Reorder and rename CSV columns using explicit source and target names.
/// Every source name must occur exactly once and target names must be unique.
/// The returned first row contains `target_columns`; remaining rows are values.
pub fn map_columns(
    rows: String[][],
    source_columns: String[],
    target_columns: String[]
) -> Result<String[][], String> {
    if len(rows) == 0 {
        return Err("CSV mapping requires a header row")
    }
    if len(source_columns) == 0 || len(source_columns) != len(target_columns) {
        return Err("CSV source and target column lists must have the same non-zero length")
    }
    headers = rows[0]
    mutable source_indexes: Int[] = []
    mutable mapping_index = 0
    while mapping_index < len(source_columns) {
        if source_columns[mapping_index] == "" || target_columns[mapping_index] == "" {
            return Err("CSV mapping column names must not be empty")
        }
        mutable prior_target = 0
        mutable duplicate_target = false
        while prior_target < mapping_index {
            if target_columns[prior_target] == target_columns[mapping_index] {
                duplicate_target = true
            }
            prior_target = prior_target + 1
        }
        if duplicate_target {
            return Err("CSV target column names must be unique")
        }
        mutable source_index = 0
        mutable matches = 0
        mutable found_index = 0
        while source_index < len(headers) {
            if headers[source_index] == source_columns[mapping_index] {
                matches = matches + 1
                found_index = source_index
            }
            source_index = source_index + 1
        }
        if matches == 0 {
            return Err("CSV source column is missing: " + source_columns[mapping_index])
        }
        if matches > 1 {
            return Err("CSV source column is ambiguous: " + source_columns[mapping_index])
        }
        source_indexes = append(source_indexes, found_index)
        mapping_index = mapping_index + 1
    }

    mutable mapped: String[][] = [target_columns]
    mutable row_index = 1
    while row_index < len(rows) {
        if len(rows[row_index]) != len(headers) {
            return Err("CSV row " + to_string(row_index + 1) + " has a different number of columns than the header")
        }
        mutable mapped_row: String[] = []
        mutable column_index = 0
        while column_index < len(source_indexes) {
            mapped_row = append(mapped_row, rows[row_index][source_indexes[column_index]])
            column_index = column_index + 1
        }
        mapped = append(mapped, mapped_row)
        row_index = row_index + 1
    }
    return Ok(mapped)
}

/// Supported, explicit CSV conversions. These are selected by the caller and
/// are never inferred from a database schema.
pub enum CsvColumnType {
    Text
    Integer
    Boolean
    Decimal
    Date
    Time
}

/// A converted cell keeps its source-language type instead of storing a
/// formatted string that could later be mistaken for validated data.
pub enum CsvValue {
    Text(String)
    Integer(Int)
    Boolean(Bool)
    Decimal(Decimal)
    Date(Date)
    Time(Time)
}

pub struct CsvColumnMapping {
    source_name: String
    target_name: String
    value_type: CsvColumnType
}

pub struct CsvConvertedTable {
    column_names: String[]
    rows: CsvValue[][]
}

/// Select, rename, and explicitly convert CSV cells. Numeric, Boolean, and
/// temporal parsing return typed Results; malformed cells produce a regular
/// conversion error with their source row and target column. This is
/// validation only: it does not infer a schema or write to a database.
pub fn convert_columns(
    rows: String[][],
    mappings: CsvColumnMapping[]
) -> Result<CsvConvertedTable, String> {
    if len(rows) == 0 {
        return Err("CSV conversion requires a header row")
    }
    if len(mappings) == 0 {
        return Err("CSV conversion requires at least one column mapping")
    }

    mutable source_columns: String[] = []
    mutable target_columns: String[] = []
    mutable mapping_index = 0
    while mapping_index < len(mappings) {
        source_columns = append(source_columns, mappings[mapping_index].source_name)
        target_columns = append(target_columns, mappings[mapping_index].target_name)
        mapping_index = mapping_index + 1
    }

    match map_columns(rows, source_columns, target_columns) {
        Err(message) => { return Err(message) }
        Ok(mapped) => {
            mutable converted_rows: CsvValue[][] = []
            mutable row_index = 1
            while row_index < len(mapped) {
                mutable converted_row: CsvValue[] = []
                mutable column_index = 0
                while column_index < len(mappings) {
                    cell = mapped[row_index][column_index]
                    target_name = mappings[column_index].target_name
                    match mappings[column_index].value_type {
                        CsvColumnType::Text => {
                            converted_row = append(converted_row, CsvValue::Text(cell))
                        }
                        CsvColumnType::Integer => {
                            match parse_int(cell) {
                                Ok(value) => {
                                    converted_row = append(converted_row, CsvValue::Integer(value))
                                }
                                Err(_) => {
                                    return Err("CSV row " + to_string(row_index + 1) + " column " + target_name + ": invalid integer")
                                }
                            }
                        }
                        CsvColumnType::Boolean => {
                            match parse_bool(cell) {
                                Ok(value) => {
                                    converted_row = append(converted_row, CsvValue::Boolean(value))
                                }
                                Err(_) => {
                                    return Err("CSV row " + to_string(row_index + 1) + " column " + target_name + ": invalid boolean")
                                }
                            }
                        }
                        CsvColumnType::Decimal => {
                            match parse_decimal(cell) {
                                Ok(value) => {
                                    converted_row = append(converted_row, CsvValue::Decimal(value))
                                }
                                Err(_) => {
                                    return Err("CSV row " + to_string(row_index + 1) + " column " + target_name + ": invalid decimal")
                                }
                            }
                        }
                        CsvColumnType::Date => {
                            match parse_date(cell) {
                                Ok(value) => {
                                    converted_row = append(converted_row, CsvValue::Date(value))
                                }
                                Err(_) => {
                                    return Err("CSV row " + to_string(row_index + 1) + " column " + target_name + ": invalid date (expected YYYY-MM-DD)")
                                }
                            }
                        }
                        CsvColumnType::Time => {
                            match parse_time(cell) {
                                Ok(value) => {
                                    converted_row = append(converted_row, CsvValue::Time(value))
                                }
                                Err(_) => {
                                    return Err("CSV row " + to_string(row_index + 1) + " column " + target_name + ": invalid time (expected HH:MM:SS)")
                                }
                            }
                        }
                    }
                    column_index = column_index + 1
                }
                converted_rows = append(converted_rows, converted_row)
                row_index = row_index + 1
            }
            converted_table = CsvConvertedTable {
                column_names: target_columns
                rows: converted_rows
            }
            return Ok(converted_table)
        }
    }
}
