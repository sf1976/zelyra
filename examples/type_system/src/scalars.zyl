pub fn identity_int(value: Int) -> Int {
    return value
}
pub fn identity_uint(value: UInt) -> UInt {
    return value
}
pub fn identity_float(value: Float) -> Float {
    return value
}
pub fn identity_bool(value: Bool) -> Bool {
    return value
}
pub fn identity_char(value: Char) -> Char {
    return value
}
pub fn identity_string(value: String) -> String {
    return value
}
pub fn identity_timestamp(value: Timestamp) -> Timestamp {
    return value
}
pub fn identity_date(value: Date) -> Date {
    return value
}
pub fn identity_time(value: Time) -> Time {
    return value
}
pub fn identity_duration(value: Duration) -> Duration {
    return value
}
pub fn identity_bytes(value: Bytes) -> Bytes {
    return value
}
pub fn run() uses Clock {
    int_max = json_decode<Int>("9223372036854775807")
    int_min = json_decode<Int>("-9223372036854775808")
    assert(identity_int(int_max) == int_max, "Int signed upper bound round-trips")
    assert(identity_int(int_min) == int_min, "Int signed lower bound round-trips")
    assert(int_min<0 && int_max>0, "Int signed comparisons")
    assert(-7 / 2 ==-3 &&-7 % 2 ==-1, "Int division truncates toward zero")
    mutable changed_int = identity_int(1)
    changed_int = 2
    assert(changed_int == 2, "Int mutable binding can be reassigned")
    uint_max = json_decode<UInt>("18446744073709551615")
    uint_one = json_decode<UInt>("1")
    uint_two = identity_uint(uint_one + uint_one)
    assert(uint_max > uint_two && uint_two == json_decode<UInt>("2"), "UInt range, arithmetic and comparisons")
    mutable changed_uint = identity_uint(uint_one)
    changed_uint = uint_two
    assert(changed_uint == uint_two, "UInt mutable binding can be reassigned")
    decimal_typed = decimal("0.1") + decimal("0.2")
    float_sum = identity_float(0.1 + 0.2)
    assert(float_sum != 0.3, "Float uses binary floating point")
    mutable changed_float = identity_float(1.5)
    changed_float = 2.5
    assert(changed_float == 2.5, "Float mutable binding can be reassigned")
    assert(decimal_typed == decimal("0.3"), "Decimal arithmetic is exact in base 10")
    assert(decimal("1.25") * decimal("2") == decimal("2.5"), "Decimal multiplication retains exact scale")
    assert(decimal("1") / decimal("4") == decimal("0.25"), "Decimal division uses fixed base-10 scale")
    assert(json_decode<Decimal>(json_encode(decimal_typed)) == decimal_typed, "Decimal JSON round trip uses an exact decimal string")
    infinity = 1.0 / 0.0
    not_a_number = 0.0 / 0.0
    assert(infinity > 1.0, "Float division follows IEEE infinity behavior")
    assert(not_a_number != not_a_number, "NaN follows IEEE comparison behavior")
    assert(identity_bool(true) &&!identity_bool(false), "Bool values and comparison")
    mutable changed_bool = identity_bool(false)
    changed_bool = true
    assert(changed_bool == true, "Bool mutable binding can be reassigned")
    compass = identity_char('🧭')
    assert(compass == '🧭', "Char stores one Unicode scalar")
    mutable changed_char = identity_char('a')
    changed_char = 'ä'
    assert(changed_char == 'ä', "Char mutable binding can be reassigned")
    text = identity_string("Grüße, \"Welt\"\n🧭")
    mutable changed_string = identity_string("")
    changed_string = "gefüllt"
    assert(changed_string == "gefüllt", "String mutable binding can be reassigned")
    assert("Alpha" < "Beta", "String ordering is lexicographic")
    chars = text_chars("Aä🧭")
    assert(chars[0] == "A" && chars[1] == "ä" && chars[2] == "🧭", "Unicode text is split by code point")
    assert(len(chars) == 3, "text_chars counts Unicode scalar values")
    assert(text == "Grüße, \"Welt\"\n🧭", "String preserves Unicode and escapes")
    timestamp = identity_timestamp(now())
    assert(timestamp == identity_timestamp(timestamp), "Timestamp supports creation, passing and equality")
    assert(text_contains(format_timestamp(timestamp), "T"), "Timestamp formats as UTC ISO-8601")
    timestamp_copy = json_decode<Timestamp>(json_encode(timestamp))
    assert(timestamp_copy == timestamp, "Timestamp JSON round trip uses integer milliseconds")
    day = identity_date(date("2026-10-11"))
    later_day = date("2026-10-12")
    assert(day < later_day, "Date validates ISO calendar values and orders chronologically")
    assert(json_decode<Date>(json_encode(day)) == day, "Date JSON round trip uses ISO text")
    morning = identity_time(time("09:30:00"))
    assert(morning < time("10:00:00"), "Time validates and orders ISO clock values")
    assert(json_decode<Time>(json_encode(morning)) == morning, "Time JSON round trip uses ISO text")
    short = identity_duration(duration_ms(1500))
    assert(short + duration_ms(500) == duration_ms(2000), "Duration uses checked millisecond arithmetic")
    assert(json_decode<Duration>(json_encode(short)) == short, "Duration JSON round trip uses milliseconds")
    payload = identity_bytes(bytes([0, 65, 255]))
    assert(payload == bytes([0, 65, 255]), "Bytes preserve all byte values")
    assert(json_decode<Bytes>(json_encode(payload)) == payload, "Bytes JSON round trip uses integer arrays")
    print("PASS Int/UInt ranges, arithmetic, comparisons, parameters and returns")
    print("PASS Decimal exact base-10 arithmetic and Float binary precision, infinity and NaN")
    print("PASS Bool, Char, String, Unicode, Timestamp, Date, Time, Duration and Bytes")
}
