pub fn identity<T>(value: T) -> T {
    return value
}
pub fn preserve<T>(value: T) -> T {
    return identity<T>(value)
}
pub fn first_or<T>(values: T[], fallback: T) -> T {
    if len(values) > 0 {
        return values[0]
    }
    return fallback
}
pub fn option_or<T>(value: Option<T>, fallback: T) -> T {
    match value {
        Some(found) => {
            return found
        }
        None => {
            return fallback
        }
    }
}
pub fn run() {
    assert(preserve(7) == 7, "nested generic function call")
    assert(identity<String>("Grüße") == "Grüße", "explicit generic type argument")
    assert(first_or(["Artikel"], "leer") == "Artikel", "generic array parameter")
    assert(first_or<String>([], "leer") == "leer", "empty generic array")
    assert(option_or(Some(12), 0) == 12, "generic Option parameter")
    assert(option_or<Int>(None, 0) == 0, "explicit generic Option type")
    print("PASS user-defined generic functions, inference and explicit types")
}
