import "src/model.zyl" as model
pub fn load_state() -> Result<model::State, String>uses FileSystem {
    return load_state_from("data/state.json")
}
pub fn load_state_from(path: String) -> Result<model::State, String>uses FileSystem {
    match read_text_result(path) {
        Ok(contents) => {
            match json_decode_result<model::State>(contents) {
                Ok(state) => {
                    return Ok(state)
                }
                Err(message) => {
                    return Err("Die JSON-Datei ist ungueltig: " + message)
                }
            }
        }
        Err(message) => {
            return Err("Die Datendatei konnte nicht gelesen werden: " + message)
        }
    }
}
pub fn save_state(state: model::State) -> Bool uses FileSystem {
    return save_state_to("data/state.json", state)
}
pub fn save_state_to(path: String, state: model::State) -> Bool uses FileSystem {
    encoded = json_encode(state)
    match atomic_write_text_result(path, encoded) {
        Ok(_) => {
            return true
        }
        Err(message) => {
            print("Speichern fehlgeschlagen: " + message)
            return false
        }
    }
}
