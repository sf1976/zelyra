database main {
    engine: mariadb
}

table departments {
    id: Id primary auto
    name: String(100) required unique
}

table machines {
    id: Id primary auto
    number: String(30) required unique
    name: String(100) required
    department: Department required
    active: Bool default true
}

crud Department -> departments

form MachineCreate -> machines {
    fields {
        number
        name
        department
        active
    }

    action save {
        sql {
            INSERT INTO machines (number, name, department_id, active)
            VALUES (:number, :name, :department, :active)
        }

        success "Machine saved."
        redirect "/machines"
    }
}

crud Machine -> machines {
    title: "Machines"

    list {
        id
        number
        name
        department
        active
    }

    search {
        number
        name
    }

    filter {
        department
        active
    }

    action set_active {
        label: "Set active status"
        icon: "check"
        confirm: "Change the machine status?"

        field active: Bool {
            label: "Active"
            required
        }

        sql {
            UPDATE machines
            SET active = :active
            WHERE id = :id
        }

        success "Machine status updated."
        success_page {
            title: "Machine updated"
            message: "The machine status was updated successfully."
        }
        error_page {
            title: "Machine update failed"
            message: "The machine status could not be updated."
        }
        redirect "/machines"
    }

    action move_department {
        label: "Move department"
        icon: "swap"

        confirm_page {
            title: "Confirm department change"
            message: "Please confirm that this machine should move to the selected department."
            submit: "Move machine"
        }

        field department: Department {
            label: "Department"
            required
        }

        sql {
            UPDATE machines
            SET department_id = :department
            WHERE id = :id
        }

        success "Machine department updated."
        redirect "/machines"
    }
}
