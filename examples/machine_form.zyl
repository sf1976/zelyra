database main {
    engine: mariadb
}

table departments {
    id: Id primary auto
    name: String(100) required unique
}

table machines {
    id: Id primary auto
    number: String(30) required unique
    name: String(100) required
    department: Department required
    active: Bool default true
    deleted_at: Timestamp?
}

form MachineCreate -> machines {
    fields {
        number
        name
        department
        active
    }

    action save {
        sql {
            INSERT INTO machines (number, name, department_id, active)
            VALUES (:number, :name, :department, :active)
        }

        success "@i18n:machines.form.saved"
        redirect "/machines"
    }
}

view ZelyraShell {
    html {
        <!doctype html>
        <html data-zelyra-language>
            <head>
                <meta charset="utf-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1" />
                <title data-zelyra-i18n="app.document_title"></title>
            </head>
            <body>
                <div class="zelyra-app">
                    <aside class="zelyra-sidebar">
                        <a class="zelyra-brand" href="/machines">
                            <span class="zelyra-mark" aria-hidden="true">Z</span>
                            <span class="zelyra-brand-copy"><span class="zelyra-brand-name">Zelyra</span><span class="zelyra-brand-descriptor" data-zelyra-i18n="app.brand_descriptor"></span></span>
                        </a>
                        <p class="zelyra-sidebar-caption" data-zelyra-i18n="app.sidebar_caption"></p>
                        <nav class="zelyra-nav">
                            <a href="/machines"><span class="zelyra-nav-icon" aria-hidden="true">01</span><span class="zelyra-nav-label" data-zelyra-i18n="app.nav_machines"></span></a>
                            <a href="/departments"><span class="zelyra-nav-icon" aria-hidden="true">02</span><span class="zelyra-nav-label" data-zelyra-i18n="app.nav_departments"></span></a>
                        </nav>
                        <div class="zelyra-sidebar-footer"><span class="zelyra-status-dot" aria-hidden="true"></span><span data-zelyra-i18n="app.connection_status"></span></div>
                    </aside>
                    <div class="zelyra-workspace">
                        <header class="zelyra-topbar">
                            <div class="zelyra-breadcrumb"><span data-zelyra-i18n="app.sidebar_caption"></span><span aria-hidden="true">/</span><strong>Zelyra</strong></div>
                            <span class="zelyra-environment"><span class="zelyra-status-dot" aria-hidden="true"></span><span data-zelyra-i18n="app.environment_label"></span></span>
                        </header>
                        <section class="zelyra-hero">
                            <div class="zelyra-hero-copy">
                                <p class="zelyra-hero-eyebrow" data-zelyra-i18n="app.workspace_label"></p>
                                <h1 data-zelyra-i18n="app.workspace_title"></h1>
                                <p class="zelyra-hero-description" data-zelyra-i18n="app.workspace_description"></p>
                            </div>
                            <span class="zelyra-hero-orbit" aria-hidden="true"></span>
                        </section>
                        <div class="zelyra-page-content"><slot /></div>
                    </div>
                </div>
            </body>
        </html>
    }
}

page "/" {
    view: ZelyraShell
    html {
        <section class="zelyra-home-card">
            <h2 data-zelyra-i18n="app.home_title"></h2>
            <p data-zelyra-i18n="app.home_description"></p>
            <div class="zelyra-home-actions">
                <a class="zelyra-home-link" href="/machines" data-zelyra-i18n="app.home_machines"></a>
                <a class="zelyra-home-link secondary" href="/departments" data-zelyra-i18n="app.home_departments"></a>
            </div>
        </section>
    }
}

crud Department -> departments {
    layout: ZelyraShell
}

crud Machine -> machines {
    layout: ZelyraShell

    soft_delete {
        column: deleted_at
    }

    list {
        number
        name
        department
        active
    }

    search {
        number
        name
    }

    filter {
        department
        active
    }

    action set_active {
        label: "@i18n:machines.action.set_active"
        icon: "check"
        confirm: "@i18n:machines.action.confirm_status"

        field active: Bool {
            label: "@i18n:identifier.active"
            required
        }

        sql {
            UPDATE machines
            SET active = :active
            WHERE id = :id
        }

        success "@i18n:machines.action.status_success"
        success_page {
            title: "@i18n:machines.action.status_title"
            message: "@i18n:machines.action.status_message"
        }
        error_page {
            title: "@i18n:machines.action.status_error_title"
            message: "@i18n:machines.action.status_error_message"
        }
        redirect "/machines"
    }

    action move_department {
        label: "@i18n:machines.action.move_department"
        icon: "swap"

        confirm_page {
            title: "@i18n:machines.action.confirm_department_title"
            message: "@i18n:machines.action.confirm_department_message"
            submit: "@i18n:machines.action.move_machine"
        }

        field department: Department {
            label: "@i18n:identifier.department"
            required
        }

        sql {
            UPDATE machines
            SET department_id = :department
            WHERE id = :id
        }

        success "@i18n:machines.action.department_success"
        redirect "/machines"
    }
}
