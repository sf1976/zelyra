import "src/database.zyl" as storage
import "src/auth.zyl" as identity
import "src/customers.zyl" as customers
import "src/shell.zyl" as shell

table orders {
    id: Id primary auto
    customer: customers::Customer required
    order_number: String(40) required unique
    status: String(20) default "open"
    total: Money required
    access {
        read: ["src/reporting.zyl"]
    }
}

crud Order -> orders {
    requires auth
    permits "orders.view"
    permits create "orders.create"
    permits edit "orders.edit"
    permits delete "orders.delete"

    layout: CustomerOrderShell
    title: "Orders"

    view {
        fields { order_number customer status total }
        list { mode: cards }
        detail { mode: cards }
        form { mode: cards }
    }

    list { order_number customer status total }
    search { order_number status }
    filter { status }
}
