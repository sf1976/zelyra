import "src/database.zyl" as storage
import "src/auth.zyl" as identity
import "src/shell.zyl" as shell

pub struct Customer {
    id: Id
    name: String
    email: Email?
}

table customers {
    id: Id primary auto
    name: String(120) required
    email: Email?
    access {
        read: ["src/reporting.zyl"]
    }
}

crud Customer -> customers {
    requires auth
    permits "customers.view"
    permits create "customers.create"
    permits edit "customers.edit"
    permits delete "customers.delete"

    layout: CustomerOrderShell
    title: "Customers"

    view {
        fields { name email }
        detail { mode: cards }
        form { mode: cards }
    }

    list { name email }
    search { name email }
}
