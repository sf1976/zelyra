view AppShell {
    html {
        <header><slot name="header" /></header>
        <main><slot /></main>
    }
}

page "/dashboard" {
    view: AppShell
    html {
        <slot name="footer"><p>Unknown slot</p></slot>
        <p>Dashboard content</p>
    }
}

fn main() {
    print("This example is expected to fail with E-VIEW-029")
}
