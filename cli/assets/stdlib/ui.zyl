# Zelyra UI 1.0 public component module.
# Import explicitly with: import "zelyra/ui" as ui

pub enum UiAppearance {
    default
    success
    warning
    danger
}

pub enum UiGridColumns {
    one
    two
    three
    four
}

pub component AppShell {
    props {
        id: String
        navigation_label: String
    }
    html {
        <div class="z-app-shell">
            <header class="z-app-shell__header">
                <slot name="header" />
                <div class="z-toolbar">
                    <button class="z-button z-mobile-nav__toggle" type="button" data-z-mobile-nav-toggle aria-controls="{id}-navigation" aria-expanded="false" hidden>{navigation_label}</button>
                    <button class="z-button" type="button" data-z-theme-toggle data-z-theme-toggle-label hidden aria-label="Farbschema wechseln">Farbschema: hell</button>
                </div>
            </header>
            <aside class="z-app-shell__sidebar">
                <nav class="z-app-shell__navigation" id="{id}-navigation" aria-label="{navigation_label}">
                    <slot name="navigation" />
                </nav>
            </aside>
            <main class="z-app-shell__main" id="{id}-main">
                <slot />
            </main>
            <footer class="z-app-shell__footer">
                <slot name="footer" />
            </footer>
        </div>
    }
}

pub component Container {
    html { <div class="z-container"><slot /></div> }
}

pub component PageHeader {
    props {
        title: String
        description: String?
    }
    html {
        <header class="z-page-header">
            <div class="z-page-header__copy">
                <h1 class="z-page-header__title">{title}</h1>
                <p class="z-page-header__description">{description}</p>
            </div>
            <div class="z-page-header__actions"><slot name="actions" /></div>
        </header>
    }
}

pub component Grid {
    props { columns: UiGridColumns? }
    html { <div class="z-grid z-grid--{columns}"><slot /></div> }
}

pub component Stack {
    html { <div class="z-stack"><slot /></div> }
}

pub component Inline {
    html { <div class="z-inline"><slot /></div> }
}

pub component Toolbar {
    html { <div class="z-toolbar" role="toolbar"><slot /></div> }
}

pub component Divider {
    html { <hr class="z-divider" /> }
}

pub component Card {
    props { title: String? }
    html {
        <section class="z-card">
            <header class="z-card__header"><h2 class="z-card__title">{title}</h2><slot name="header" /></header>
            <div class="z-card__body"><slot /></div>
            <footer class="z-card__footer"><slot name="footer" /></footer>
        </section>
    }
}

pub component Badge {
    props {
        text: String
        appearance: UiAppearance?
    }
    html { <span class="z-badge z-badge--{appearance}">{text}</span> }
}

pub component Alert {
    props {
        title: String
        appearance: UiAppearance?
    }
    html {
        <section class="z-alert z-alert--{appearance}" role="status">
            <h2 class="z-alert__title">{title}</h2>
            <div><slot /></div>
        </section>
    }
}

pub component EmptyState {
    props {
        id: String
        title: String
        description: String?
    }
    html {
        <section class="z-empty-state" aria-labelledby="{id}-title">
            <h2 id="{id}-title">{title}</h2>
            <p>{description}</p>
            <div class="z-empty-state__actions"><slot name="actions" /></div>
        </section>
    }
}

pub component LoadingState {
    props { label: String }
    html {
        <section class="z-loading-state" role="status" aria-live="polite">
            <span class="z-loading-state__indicator" aria-hidden="true"></span>
            <p>{label}</p>
        </section>
    }
}

pub component ErrorState {
    props {
        title: String
        message: String
    }
    html {
        <section class="z-error-state" role="alert">
            <h2>{title}</h2>
            <p>{message}</p>
            <div class="z-error-state__actions"><slot name="actions" /></div>
        </section>
    }
}

pub component Breadcrumbs {
    props { label: String? }
    html {
        <nav class="z-breadcrumbs" aria-label="{label}">
            <ol><slot /></ol>
        </nav>
    }
}

pub component DescriptionList {
    html { <dl class="z-description-list"><slot /></dl> }
}

pub component Progress {
    props {
        label: String
        value: UInt
        max: UInt
    }
    html {
        <label class="z-progress-field">
            <span>{label}</span>
            <progress class="z-progress" value="{value}" max="{max}">{value}</progress>
        </label>
    }
}

# `Button` deliberately defaults to type=button. A supplied href selects an
# anchor; use SubmitButton when the intended action submits a form.
pub component Button {
    props {
        label: String
        href: String?
        appearance: UiAppearance?
        translation_key: String?
    }
    html {
        <z-if prop="href"><a class="z-button z-button--{appearance}" href="{href}" data-zelyra-i18n="{translation_key}">{label}</a></z-if>
        <z-else><button class="z-button z-button--{appearance}" type="button" data-zelyra-i18n="{translation_key}">{label}</button></z-else>
    }
}

pub component SubmitButton {
    props {
        label: String
        appearance: UiAppearance?
        translation_key: String?
    }
    html { <button class="z-button z-button--{appearance}" type="submit" data-zelyra-i18n="{translation_key}">{label}</button> }
}

pub component ButtonGroup {
    html { <div class="z-button-group" role="group"><slot /></div> }
}

pub component Link {
    props {
        href: String
        label: String
    }
    html { <a class="z-link" href="{href}">{label}</a> }
}

pub component Pagination {
    props { label: String? }
    html { <nav class="z-pagination" aria-label="{label}"><slot /></nav> }
}

# Tab links remain ordinary fragment links without JavaScript. The local
# progressive script enhances them to keyboard-operable tabs.
pub component Tabs {
    props {
        id: String
        first_label: String
        second_label: String
    }
    html {
        <nav class="z-tabs" data-z-tabs aria-label="Sections">
            <a class="z-tab" href="#{id}-panel-one" data-z-tab>{first_label}</a>
            <a class="z-tab" href="#{id}-panel-two" data-z-tab>{second_label}</a>
        </nav>
        <section class="z-tabs__panel" id="{id}-panel-one" data-z-tab-panel><slot name="first" /></section>
        <section class="z-tabs__panel" id="{id}-panel-two" data-z-tab-panel><slot name="second" /></section>
    }
}

pub component Dropdown {
    props { label: String }
    html {
        <details class="z-dropdown">
            <summary>{label}</summary>
            <div class="z-dropdown__menu"><slot /></div>
        </details>
    }
}

pub component Disclosure {
    props { summary: String }
    html { <details class="z-disclosure"><summary>{summary}</summary><div><slot /></div></details> }
}

pub component MobileNavigation {
    props {
        id: String
        label: String
    }
    html {
        <div class="z-mobile-nav" data-z-mobile-nav>
            <button class="z-button z-mobile-nav__toggle" type="button" data-z-mobile-nav-toggle aria-controls="{id}" aria-expanded="false" hidden>{label}</button>
            <nav class="z-mobile-nav__panel" id="{id}" aria-label="{label}"><slot /></nav>
        </div>
    }
}

pub component TextField {
    props {
        id: String
        name: String
        label: String
        value: String?
        placeholder: String?
        required: Bool?
        disabled: Bool?
        readonly: Bool?
        invalid: Bool?
        appearance: UiAppearance?
    }
    html {
        <div class="z-field">
            <label class="z-field__label" for="{id}">{label}</label>
            <input class="z-input z-input--{appearance}" id="{id}" name="{name}" type="text" value="{value}" placeholder="{placeholder}" required="{required}" disabled="{disabled}" readonly="{readonly}" aria-invalid="{invalid}" aria-describedby="{id}-hint {id}-error" />
            <small class="z-field__hint" id="{id}-hint"><slot name="hint" /></small>
            <small class="z-field__error" id="{id}-error"><slot name="error" /></small>
        </div>
    }
}

pub component EmailField {
    props {
        id: String
        name: String
        label: String
        value: String?
        placeholder: String?
        required: Bool?
        disabled: Bool?
        invalid: Bool?
        appearance: UiAppearance?
    }
    html {
        <div class="z-field">
            <label class="z-field__label" for="{id}">{label}</label>
            <input class="z-input z-input--{appearance}" id="{id}" name="{name}" type="email" value="{value}" placeholder="{placeholder}" required="{required}" disabled="{disabled}" aria-invalid="{invalid}" aria-describedby="{id}-hint {id}-error" />
            <small class="z-field__hint" id="{id}-hint"><slot name="hint" /></small>
            <small class="z-field__error" id="{id}-error"><slot name="error" /></small>
        </div>
    }
}

pub component PasswordField {
    props {
        id: String
        name: String
        label: String
        autocomplete: String?
        required: Bool?
        disabled: Bool?
        invalid: Bool?
