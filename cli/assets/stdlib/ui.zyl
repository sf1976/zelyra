pub component TimeField {
    props {
        id: String
        name: String
        label: String
        value: Time?
        required: Bool?
        disabled: Bool?
        invalid: Bool?
        appearance: UiAppearance?
    }
    html {
        <div class="z-field">
            <label class="z-field__label" for="{id}">{label}</label>
            <input class="z-input z-input--{appearance}" id="{id}" name="{name}" type="time" value="{value}" required="{required}" disabled="{disabled}" aria-invalid="{invalid}" aria-describedby="{id}-hint {id}-error" />
            <small class="z-field__hint" id="{id}-hint"><slot name="hint" /></small>
            <small class="z-field__error" id="{id}-error"><slot name="error" /></small>
