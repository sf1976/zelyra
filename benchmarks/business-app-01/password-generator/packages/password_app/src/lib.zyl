import "zelyra/ui" as ui
import "pkg:password_engine" as passwords
import "pkg:zelyra_identity" as identity

pub fn generate_password(length: Int, character_set: String) -> String uses Random {
    return passwords::generate_password(length, character_set)
}

page "/" {
    html {
        <Container>
            <PageHeader
                title="Passwortgenerator"
                description="Sicher anmelden und Passwörter direkt auf diesem Server erzeugen."
            />
            <Grid columns="two">
                <Card title="Dein geschützter Arbeitsbereich">
                    <p>Der Generator ist nur nach einer Anmeldung erreichbar. Benutzerkonten werden verwaltet, eine öffentliche Registrierung ist ausgeschaltet.</p>
                    <Button label="Anmelden" href="/login" />
                    <Button label="Zum Passwortgenerator" href="/generator" appearance="success" />
                </Card>
                <Card title="Sicher und lokal">
                    <p>Die Zufallswerte werden mit Zelyras sicherer Random-Capability erzeugt. Passwörter werden weder gespeichert noch protokolliert.</p>
                </Card>
                <Card title="Zelyra Work-Modus">
                    <p>Diese Anwendung läuft mit <code>ZELYRA_LEVEL=work</code>. Sie enthält keinen Lernmodus und keine Anwendung in einer Fremdsprache.</p>
                </Card>
            </Grid>
        </Container>
    }
}

form PasswordGenerator {
    route: "/generator"

    field length: Int {
        label: "Länge"
        required
        min_value: "8"
        max_value: "64"
        widget: number
    }

    field character_set: String {
        label: "Zeichensatz"
        required
        choices: ["Nur Kleinbuchstaben", "Nur Ziffern", "Buchstaben", "Buchstaben und Ziffern", "Alle Zeichen"]
    }

    action generate {
        label: "Passwort erzeugen"
        requires auth
        permits "password_generator.use"
        handler: generate_password
        uses Random
    }
}
